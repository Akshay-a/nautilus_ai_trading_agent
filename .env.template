# Exchange API Keys
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=false
BYBIT_DEMO=false
INSTRUMENT_ID=BTCUSDT-LINEAR.BYBIT

# AI Service API Keys
DEEPSEEK_API_KEY=

# Optional: If you need OKX for reference or testing
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=

# Strategy Parameters (override YAML config)
EQUITY=100000                    # Reference capital in USDT
LEVERAGE=20                      # Position leverage — match Bybit account setting
BASE_POSITION_USDT=2500          # Fallback base position size in USDT
FIXED_TRADE_USDT=2500            # Fixed notional target per entry/reversal (set 0 to disable)

# Risk Management
MAX_POSITION_RATIO=20.0          # Notional cap as equity multiple; fixed_trade_usdt is primary limiter
HIGH_CONFIDENCE_MULTIPLIER=1.5
MEDIUM_CONFIDENCE_MULTIPLIER=1.0
LOW_CONFIDENCE_MULTIPLIER=0.5
TREND_STRENGTH_MULTIPLIER=1.2

# Trading Parameters
TIMEFRAME=5m                     # Bar interval (1m, 5m, 15m, 1h, etc.)
TIMER_INTERVAL_SEC=300           # Ops/maintenance cadence (LLM is market-state gated)
MIN_CONFIDENCE_TO_TRADE=MEDIUM  # LOW, MEDIUM, HIGH
ENABLE_MARKET_STATE_GATE=true   # Skip LLM when regime/structure/OB unchanged

# Testing
TEST_MODE=false                 # Set to true for simulation mode
DRY_RUN=false                   # Set to true to skip order execution (paper/live data mode)

# Logging
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/deepseek_strategy.log

# Monitoring
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
